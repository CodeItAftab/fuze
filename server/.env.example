PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# 1. Database & Cache (Matches docker-compose.yml)
DATABASE_URL=postgresql://fuze:fuze_password@localhost:5432/fuze
REDIS_URL=redis://localhost:6379

# 2. Security Keys (Generate real keys in Step 2 below)
# Run this in terminal: node -e "const c=require('crypto'); console.log('JWT_SECRET=' + c.randomBytes(32).toString('hex')); console.log('COOKIE_SECRET=' + c.randomBytes(32).toString('hex')); console.log('ENCRYPTION_KEY=' + c.randomBytes(32).toString('hex'));"
JWT_SECRET=your_jwt_secret_32_bytes_hex
COOKIE_SECRET=your_cookie_secret_32_bytes_hex
ENCRYPTION_KEY=your_aes256_encryption_key_64_hex_chars

# 3. Google Drive
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/providers/google/callback

# 4. Microsoft OneDrive
MICROSOFT_CLIENT_ID=your_azure_client_id
MICROSOFT_CLIENT_SECRET=your_azure_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:4000/providers/onedrive/callback

# 5. Dropbox
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI=http://localhost:4000/providers/dropbox/callback

# 6. pCloud
PCLOUD_CLIENT_ID=your_pcloud_client_id
PCLOUD_CLIENT_SECRET=your_pcloud_client_secret
PCLOUD_REDIRECT_URI=http://localhost:4000/providers/pcloud/callback