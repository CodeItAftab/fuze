# ==============================================================================
# Fuze Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=https://fuzedrive.tech
CLIENT_URL=https://fuzedrive.tech
ALLOWED_ORIGINS=https://fuzedrive.tech,https://www.fuzedrive.tech
COOKIE_DOMAIN=.fuzedrive.tech

# ------------------------------------------------------------------------------
# 1. Database & Distributed Cache
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Local Docker, Supabase, or Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuze

# Redis connection string (Local Redis 7, or Upstash: rediss://default:...@...upstash.io:6379)
# Required for: distributed OAuth token refresh locks, BullMQ queue, and session revocation
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 2. Cryptographic Security Keys
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Fastify Cookie Signing Secret
# Generate with: openssl rand -hex 32
COOKIE_SECRET=your_cookie_signing_secret_32_bytes_hex

# AES-256-GCM Encryption Key for OAuth tokens at rest (MUST be 32 bytes / 64 hex chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. Storage Provider OAuth Credentials
# ------------------------------------------------------------------------------
# Google Drive (Google Cloud Console -> APIs & Services -> Credentials)
# Scope: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/providers/google/callback

# Microsoft OneDrive (Azure Portal -> App registrations -> Microsoft Graph)
# Scopes: Files.ReadWrite.All, offline_access
MICROSOFT_CLIENT_ID=your_azure_client_id
MICROSOFT_CLIENT_SECRET=your_azure_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:4000/providers/onedrive/callback

# Dropbox (Dropbox App Console -> Permissions)
# Scopes: files.content.write, files.content.read
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI=http://localhost:4000/providers/dropbox/callback

# Box (Box Developer Console -> Custom App -> Standard OAuth 2.0)
# Scopes: Read and write all files and folders
BOX_CLIENT_ID=your_box_client_id
BOX_CLIENT_SECRET=your_box_client_secret
BOX_REDIRECT_URI=http://localhost:4000/providers/box/callback

# pCloud (pCloud App Portal -> My Applications)
PCLOUD_CLIENT_ID=your_pcloud_client_id
PCLOUD_CLIENT_SECRET=your_pcloud_client_secret
PCLOUD_REDIRECT_URI=http://localhost:4000/providers/pcloud/callback

# ------------------------------------------------------------------------------
# 4. Email Notifications (Optional - for Email Verification & Password Resets)
# ------------------------------------------------------------------------------
EMAIL_FROM="Fuze Cloud <onboarding@resend.dev>"
RESEND_API_KEY=your_resend_api_key

# ------------------------------------------------------------------------------
# 5. Native Thumbnail Cache (Memory & Disk bounded for Free Tiers)
# ------------------------------------------------------------------------------
THUMBNAIL_CACHE_MAX_MB=150
THUMBNAIL_CACHE_DIR=.cache/thumbnails
THUMBNAIL_CACHE_TTL_DAYS=14