# ==============================================================================
# Fuze Frontend (Next.js 16) Environment Configuration
# ==============================================================================

# Backend API URL (Default local: http://localhost:4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend WebSocket URL for real-time synchronization (Default local: ws://localhost:4000/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Public Web Application Base URL (Default local: http://localhost:3000, Production: https://fuzedrive.tech)
NEXT_PUBLIC_APP_URL=http://localhost:3000
